# Required — use a long random string in production

AUTH_SECRET=change-me-to-a-long-random-secret

# Site URL (required for Zarinpal payment callback)
# NEXT_PUBLIC_SITE_URL=https://firstdata.ir

# Staff/admin API access in production (header: x-admin-key or Authorization: Bearer <key>)
# Also assign users.role = 'admin' or 'staff' in data/auth.db for web UI access
# First admin: register at /auth/register, then set role in SQLite:
#   UPDATE users SET role = 'admin' WHERE email = 'your@email.com';
# ADMIN_API_KEY=change-me-to-a-long-random-admin-key

# Optional webhook to deliver OTP emails in production (POST JSON: to, subject, text)
# OTP_EMAIL_WEBHOOK=https://your-mail-service.example/send

# Optional webhook to deliver OTP SMS in production (POST JSON: to, message, code, purpose, channel)
# OTP_SMS_WEBHOOK=https://your-sms-gateway.example/send

# Panel notifications — email/SMS (falls back to OTP_* webhooks if unset)
# PANEL_NOTIFY_EMAIL_WEBHOOK=https://your-mail-service.example/send
# PANEL_NOTIFY_SMS_WEBHOOK=https://your-sms-gateway.example/send

# Zarinpal payment gateway (Iran — Rial amounts on invoices)
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=true

# Contact form — leads saved to data/auth.db; optional webhook (POST JSON: name, email, phone, service, message, leadId, ip)
# CONTACT_WEBHOOK=https://your-automation.example/contact

# Auto-reply email to user after contact submit (falls back to OTP_EMAIL_WEBHOOK)
# CONTACT_CONFIRM_WEBHOOK=https://your-mail-service.example/send

# Client error reports in production (POST JSON: message, stack, url, userAgent, ip, at)
# ERROR_REPORT_WEBHOOK=https://your-monitoring.example/errors

# Maintenance mode — redirects all pages to /maintenance (except api, static assets)
# MAINTENANCE_MODE=false

# Analytics (optional — use one)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=firstdata.ir
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Offline service worker (enabled automatically in production builds)
# NEXT_PUBLIC_ENABLE_SW=true

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@firstdata.ir
