{
  "name": "first-data",
  "version": "1.4.9",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MrAlfak/firstdata-website.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-dev.mjs --port=3000 && next dev",
    "dev:4000": "node scripts/ensure-dev.mjs --port=4000 && next dev -p 4000",
    "build": "node scripts/ensure-build.mjs && next build --webpack",
    "start": "node scripts/ensure-start.mjs",
    "start:4000": "node scripts/ensure-start.mjs --port=4000",
    "lint": "eslint .",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "jose": "^6.2.3",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
